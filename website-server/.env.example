# Copy to .env in website-server/ and fill these values locally or in your hosting provider's secret environment.
# Never commit a real .env file or put these values in browser JavaScript.
NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=3c_dashboard
SESSION_SECRET=replace-with-at-least-32-random-characters
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-application-client-secret
DISCORD_REDIRECT_URI=https://YOUR-DASHBOARD-DOMAIN/auth/discord/callback
DASHBOARD_OWNER_DISCORD_ID=your-main-owners-discord-user-id
